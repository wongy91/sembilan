# Security headers for every static file (Cloudflare Workers static assets).
# Every host the app fetches from must be in connect-src; tests/headers.test.mjs checks this.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: blob: https://tiles.openfreemap.org; font-src 'self'; connect-src 'self' https://cdn.jsdelivr.net https://tiles.openfreemap.org https://photon.komoot.io https://valhalla1.openstreetmap.de https://router.project-osrm.org; worker-src 'self' blob:; child-src blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), screen-wake-lock=(self), camera=(), microphone=(), payment=(), usb=()
